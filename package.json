{
    "name": "@software-hardware-integration-lab/development-utilities",
    "version": "3.0.2-alpha1",
    "description": "Collection of configurations, settings and packages to be common across multiple products/repositories.",
    "main": "bin/index.js",
    "type": "module",
    "scripts": {
        "build:Dev": "tsc",
        "prebuild:Prod": "tsc -p prod.tsconfig.json --emitDeclarationOnly false",
        "build:Prod": "tsc -p prod.tsconfig.json --removeComments false",
        "lint": "eslint --max-warnings 0",
        "test:Unit": "vitest run --config vitest.unit.config.ts",
        "test:Unit:Coverage": "vitest run --config vitest.unit.config.ts --coverage",
        "test:Unit:Watch": "vitest watch --config vitest.unit.config.ts",
        "test:Integration": "vitest run --config vitest.integration.config.ts",
        "test:Integration:Coverage": "vitest run --config vitest.integration.config.ts --coverage"
    },
    "exports": {
        ".": {
            "import": "./bin/index.js"
        },
        "./optimized/lint/*.js": {
            "import": "./bin/config/linter/*.js"
        },
        "./config/typescript/*.json": "./config/typescript/*.json"
    },
    "packageManager": "npm@12.0.2",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.18.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Software-Hardware-Integration-Lab/Development-Utilities"
    },
    "keywords": [
        "ESLint",
        "config",
        "lint",
        "standardization",
        "JSDoc",
        "Stylistic",
        "TypeScript",
        "tsconfig"
    ],
    "author": "Pasha Zayko <pasha_zayko@shi.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Software-Hardware-Integration-Lab/Development-Utilities/issues"
    },
    "homepage": "https://github.com/Software-Hardware-Integration-Lab/Development-Utilities#readme",
    "dependencies": {
        "@eslint/js": "~10.0.1",
        "@stylistic/eslint-plugin": "~5.10.0",
        "eslint": "~10.8.1",
        "eslint-plugin-jsdoc": "~64.0.1",
        "eslint-plugin-react-hooks": "~7.1.1",
        "typescript-eslint": "~8.66.0"
    },
    "devDependencies": {
        "@types/eslint": "~9.6.1",
        "@types/node": "~26.2.0",
        "typescript": "~6.0.3",
        "vitest": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10"
    }
}
